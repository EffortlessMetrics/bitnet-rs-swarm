#!/usr/bin/env bash
set -euo pipefail

# Autofix only staged Rust files. Refuse partially staged Rust files so the hook
# never expands the commit by staging unrelated working-tree edits.
rust_files=()
while IFS= read -r -d '' path; do
  rust_files+=("$path")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.rs')

if ((${#rust_files[@]})); then
  for path in "${rust_files[@]}"; do
    if ! git diff --quiet -- "$path"; then
      echo "✖ Cannot autofix partially staged Rust file: $path"
      echo "  Stage or stash its working-tree changes, then commit again."
      exit 1
    fi
  done

  scripts/hooks/format-rust-files.sh "${rust_files[@]}"
  git add -- "${rust_files[@]}"
fi

# Guard: Prevent GenerationConfig struct literals in tests (must use builder API)
# Exclude snapshot (.snap) files — they contain Debug output, not source code.
if rg -n --glob '!*.snap' 'GenerationConfig\s*\{' crates/bitnet-inference/tests | grep -v ") -> GenerationConfig" >/dev/null 2>&1; then
  echo "✖ Found GenerationConfig struct literal in tests; use builder API instead."
  echo ""
  rg -n --glob '!*.snap' 'GenerationConfig\s*\{' crates/bitnet-inference/tests | grep -v ") -> GenerationConfig"
  echo ""
  echo "Example: Replace"
  echo "  GenerationConfig { max_new_tokens: 10, temperature: 0.7, ... }"
  echo "with"
  echo "  GenerationConfig::greedy().with_max_tokens(10).with_temperature(0.7)"
  exit 1
fi

exit 0
